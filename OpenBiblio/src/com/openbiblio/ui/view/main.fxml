<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openbiblio.ui.controller.MainController"
            stylesheets="@application.css">

    <left>
        <VBox spacing="20" styleClass="sidebar" prefWidth="230">
            <Label text="MiBiblioteca" styleClass="sidebar-title"/>
            <Label text="Gestor personal de libros" styleClass="sidebar-subtitle"/>

            <VBox spacing="8">
                <Button text="Biblioteca" styleClass="nav-button nav-button-active"/>
                <Button text="Añadir libro"
                        fx:id="addButton"
                        onAction="#onAddClicked"
                        styleClass="nav-button"/>

                <Button text="Exportar Biblio"
                        onAction="#onExportClicked"
                        styleClass="nav-button"/>

                <Button text="Importar Biblio"
                        onAction="#onImportClicked"
                        styleClass="nav-button"/>
                <Button text="Backup Online"
        			styleClass="nav-button"
        			onAction="#onBackupOnlineClicked"/>
        		<Button text="Restaurar Backup"
        			styleClass="nav-button"
        			onAction="#onRestoreOnlineClicked"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="24" styleClass="content">

            <VBox spacing="6">
                <Label text="Tu biblioteca" styleClass="page-title"/>
                <Label text="Organiza tus libros, lecturas pendientes y notas personales"
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="12">
                <TextField fx:id="searchField"
                           promptText="Buscar por título, autor o ISBN..."
                           HBox.hgrow="ALWAYS"
                           styleClass="search-field"/>

                <Button text="+ Añadir libro"
                        onAction="#onAddClicked"
                        styleClass="primary-button"/>
            </HBox>

            <Label text="Libros guardados" styleClass="section-title"/>

            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <FlowPane fx:id="libraryPane"
                          hgap="18"
                          vgap="18"
                          style="-fx-padding: 10;"/>
            </ScrollPane>

            <HBox spacing="12" alignment="CENTER_LEFT">

			    <Label text="Recomendaciones"
           		styleClass="section-title"/>

    			<Button text="↻ Refrescar"
            	onAction="#onRefreshRecommendations"
            	styleClass="primary-button"/>

			</HBox>

            <FlowPane fx:id="recommendationsPane"
                      hgap="18"
                      vgap="18"
                      style="-fx-padding: 10;"/>

        </VBox>
    </center>

</BorderPane>